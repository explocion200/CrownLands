rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shieldCount(data) {
      return data.get('shopItems', {}).get('shield_12h', 0);
    }

    function validPlayerProfileCreate() {
      return shieldCount(request.resource.data) == 0
        && !request.resource.data.keys().hasAny([
          'gold',
          'goldFloat',
          'shopItems',
          'itemEffects',
          'itemPurchaseCooldowns',
          'economyUpdatedAtMs',
          'offlineProductionCities',
          'kingPower',
          'kingPowerVersion',
          'kingPowerUpdatedAtMs',
          'cityCount',
          'globalStats',
          'character',
          'upgrades',
          'mainCityId',
          'mainIslandId',
          'mainRegionId',
          'mainCityChangedAtMs'
        ]);
    }

    function profileFieldUnchanged(field) {
      return request.resource.data.get(field, resource.data.get(field, null)) == resource.data.get(field, null);
    }

    function playerEconomyUnchanged() {
      return profileFieldUnchanged('gold')
        && profileFieldUnchanged('goldFloat')
        && profileFieldUnchanged('shopItems')
        && profileFieldUnchanged('itemEffects')
        && profileFieldUnchanged('itemPurchaseCooldowns')
        && profileFieldUnchanged('economyUpdatedAtMs')
        && profileFieldUnchanged('offlineProductionCities')
        && profileFieldUnchanged('kingPower')
        && profileFieldUnchanged('kingPowerVersion')
        && profileFieldUnchanged('kingPowerUpdatedAtMs')
        && profileFieldUnchanged('cityCount')
        && profileFieldUnchanged('globalStats');
    }

    function validPlayerProfileUpdate() {
      return playerEconomyUnchanged()
        && profileFieldUnchanged('character')
        && profileFieldUnchanged('upgrades')
        && profileFieldUnchanged('mainCityId')
        && profileFieldUnchanged('mainIslandId')
        && profileFieldUnchanged('mainRegionId')
        && profileFieldUnchanged('mainCityChangedAtMs');
    }

    function cityFieldUnchanged(field) {
      return request.resource.data.get(field, resource.data.get(field, null)) == resource.data.get(field, null);
    }

    function cityEconomyUnchanged() {
      return cityFieldUnchanged('troops')
        && cityFieldUnchanged('troopFloat')
        && cityFieldUnchanged('level')
        && cityFieldUnchanged('investedGold')
        && cityFieldUnchanged('productionUpdatedAtMs')
        && cityFieldUnchanged('ownerShieldExpiresAtMs');
    }

    function cityOwnerCoreUnchanged() {
      return cityFieldUnchanged('ownerUid')
        && cityFieldUnchanged('ownerKind')
        && cityFieldUnchanged('owner')
        && cityFieldUnchanged('isMainCity')
        && cityFieldUnchanged('relinquishedAtMs')
        && cityFieldUnchanged('relocatedAtMs')
        && cityFieldUnchanged('claimedAt')
        && cityFieldUnchanged('lastCapturedAt');
    }

    function cityOwnerDisplayUnchanged() {
      return cityFieldUnchanged('ownerName')
        && cityFieldUnchanged('ownerFlag')
        && cityFieldUnchanged('ownerKingPower');
    }

    function ownsCityOwnerIdentity() {
      return resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.get('ownerUid', null) == request.auth.uid;
    }

    function cityOwnershipSafeForBrowser() {
      return cityOwnerCoreUnchanged()
        && (cityOwnerDisplayUnchanged() || ownsCityOwnerIdentity());
    }

    function validCityLayoutCreate() {
      return request.resource.data.get('ownerUid', null) == null
        && request.resource.data.get('ownerKind', 'neutral') != 'player'
        && request.resource.data.get('isMainCity', false) != true;
    }

    match /players/{uid} {
      allow read: if ownsPlayerDoc(uid);
      allow create: if ownsPlayerDoc(uid) && validPlayerProfileCreate();
      allow update: if ownsPlayerDoc(uid) && validPlayerProfileUpdate();
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update: if ownsPlayerDoc(uid);
        allow delete: if ownsPlayerDoc(uid);
      }

      match /serverReports/{reportId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update, delete: if false;
      }

      match /stats/{statsId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update, delete: if false;
      }

      match /notificationTokens/{tokenId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update: if ownsPlayerDoc(uid)
          && request.resource.data.uid == uid
          && request.resource.data.token is string
          && request.resource.data.enabled is bool;
        allow delete: if ownsPlayerDoc(uid);
      }
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Multiplayer collections. Layout/profile metadata can still be updated by
    // the browser, but economy, army orders, arrivals, combat, and reports are
    // server-owned.
    match /islands/{islandId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn();
        allow create: if signedIn() && validCityLayoutCreate();
        allow update: if signedIn() && cityEconomyUnchanged() && cityOwnershipSafeForBrowser();
        allow delete: if false;
      }

      match /armies/{armyId} {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if signedIn();
        allow create, update: if false;
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsPlayerDoc(uid);
      }
    }
  }
}
