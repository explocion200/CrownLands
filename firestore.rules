rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentResetGeneration() {
      return exists(/databases/$(database)/documents/realmConfig/current)
        ? get(/databases/$(database)/documents/realmConfig/current).data.get('resetGeneration', 'fresh-2026-07-26-server-reset')
        : 'fresh-2026-07-26-server-reset';
    }

    function currentWorldId() {
      return exists(/databases/$(database)/documents/realmConfig/current)
        ? get(/databases/$(database)/documents/realmConfig/current).data.get('worldId', 'main-fresh-2026-07-26-server-reset')
        : 'main-fresh-2026-07-26-server-reset';
    }

    function currentRealmShardId() {
      return signedIn()
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        ? get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('realmShardId', 'legacy')
        : 'legacy';
    }

    function currentRealmStorageId() {
      return currentRealmShardId() == 'legacy'
        ? currentResetGeneration()
        : currentResetGeneration() + '--' + currentRealmShardId();
    }

    function isCurrentRealmShard(data) {
      return data.get('realmShardId', 'legacy') == currentRealmShardId();
    }

    function isCurrentGeneration(data) {
      return data.get('resetGeneration', '') == currentResetGeneration()
        && data.get('worldId', '') == currentWorldId()
        && isCurrentRealmShard(data);
    }

    function isCurrentIslandId(islandId) {
      return currentRealmShardId() == 'legacy'
        ? islandId.matches('^' + currentWorldId() + '-[^-].*$')
        : islandId.matches('^' + currentWorldId() + '--' + currentRealmShardId() + '--.*$');
    }

    function shieldCount(data) {
      return data.get('shopItems', {}).get('shield_12h', 0);
    }

    function validPlayerNameValue(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 18
        && value.matches('^[A-Za-z0-9 _.-]+$');
    }

    function validPlayerFlagColor(value) {
      return value is string && value.matches('^#[0-9A-Fa-f]{6}$');
    }

    function validPlayerFlagValue(flag) {
      return flag is map
        && flag.keys().hasOnly(['version', 'primary', 'secondary', 'symbolColor', 'pattern', 'symbol'])
        && flag.keys().hasAll(['primary', 'secondary', 'pattern', 'symbol'])
        && (!flag.keys().hasAny(['version']) || flag.version == 2)
        && validPlayerFlagColor(flag.primary)
        && validPlayerFlagColor(flag.secondary)
        && (!flag.keys().hasAny(['symbolColor']) || validPlayerFlagColor(flag.symbolColor))
        && flag.pattern in [
          'split', 'diagonal', 'band', 'cross', 'saltire', 'chevron', 'quartered',
          'pale', 'chief', 'bend', 'fess', 'pile', 'canton', 'invertedChevron'
        ]
        && flag.symbol in [
          'crown', 'lion', 'eagle', 'double-eagle', 'wolf', 'stag', 'boar', 'bear',
          'horse', 'dragon', 'griffin', 'raven', 'falcon', 'serpent', 'crossed-swords',
          'battle-axe', 'war-hammer', 'spearhead', 'gauntlet', 'tower', 'castle-gate',
          'fleur-de-lis', 'oak-tree', 'sunburst', 'cross', 'moon', 'diamond', 'guardian',
          'banner', 'helm',
          'castle', 'star', 'swords', 'fleur', 'sun', 'knight', 'spire', 'keep'
        ];
    }

    function validOptionalPlayerFlag(container) {
      return container is map
        && (!container.keys().hasAny(['flag']) || validPlayerFlagValue(container.flag));
    }

    function validPlayerSaveFlag() {
      return !request.resource.data.keys().hasAny(['state'])
        || (request.resource.data.state is map && validOptionalPlayerFlag(request.resource.data.state));
    }

    function validPlayerProfileNameCreate() {
      return !request.resource.data.keys().hasAny(['playerName'])
        || validPlayerNameValue(request.resource.data.playerName);
    }

    function validPlayerProfileCreate() {
      return shieldCount(request.resource.data) == 0
        && validPlayerProfileNameCreate()
        && (!request.resource.data.keys().hasAny(['flag']) || validPlayerFlagValue(request.resource.data.flag))
        && !request.resource.data.keys().hasAny([
          'gold',
          'goldFloat',
          'shopItems',
          'gear',
          'itemEffects',
          'itemPurchaseCooldowns',
          'dailyLoginReward',
          'cityUpgradeReceipts',
          'reportsViewedAtMs',
          'realmAnnouncementSeenThroughMs',
          'lastRealmAnnouncementEventId',
          'inactivityNotice',
          'worldSlotResetAtMs',
          'economyUpdatedAtMs',
          'pendingAwayProduction',
          'offlineProductionCities',
          'kingPower',
          'kingPowerVersion',
          'kingPowerUpdatedAtMs',
          'stationedReinforcementTroops',
          'reinforcementResetGeneration',
          'committedRallyTroops',
          'rallyResetGeneration',
          'activeClanReinforcementTargets',
          'activeClanReinforcementAssignments',
          'clanReinforcementLimitResetGeneration',
          'clanReinforcementLimitVersion',
          'clanObjectiveAccrual',
          'pendingClanObjectiveAccrual',
          'cityCount',
          'globalStats',
          'character',
          'upgrades',
          'skillPresets',
          'skillPointSystemVersion',
          'skillPointSystemResetAtMs',
          'skillPointSystemRollbackAtMs',
          'freeSkillResetGrantVersion',
          'freeSkillResetCredits',
          'cityUpgradeXpDaily',
          'mainCityId',
           'mainIslandId',
           'mainRegionId',
           'mainCityChangedAtMs',
           'lastCityRelinquishedAtMs',
           'mainCityAssignmentVersion',
           'clanId',
           'clanName',
           'clanTag',
           'clanRole',
           'clanIdentityRevision',
           'clanIdentityRevisionVersion',
           'clanIdentityUpdatedAtMs',
           'clanJoinCooldownUntilMs',
           'pendingClanApplicationId',
           'resetGeneration',
           'worldId',
           'realmShardId',
           'releaseId',
           'cloudSaveSlot'
        ]);
    }

    function profileFieldUnchanged(field) {
      return request.resource.data.get(field, resource.data.get(field, null)) == resource.data.get(field, null);
    }

    function validPlayerProfileUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'activeSession',
          'lastLoginAt',
          'updatedAt',
          'version',
          'snapshotKind',
          'activeIslandId',
          'activeRegionId',
          'playerName',
          'flag',
          'daily',
          'scoutReports',
          'battleReports',
          'marchPercent',
          'lastSelectedOwnedCityId',
          'gameSeconds',
          'localGameSeconds',
          'lastRealTimeMs',
          'lastSeenAtMs'
        ])
        && (!affected.hasAny(['uid']) || request.resource.data.uid == request.auth.uid)
        && (!affected.hasAny(['playerName']) || validPlayerNameValue(request.resource.data.playerName))
        && (!affected.hasAny(['flag']) || validPlayerFlagValue(request.resource.data.flag));
    }

    function ownsCityOwnerIdentity() {
      return resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.get('ownerUid', null) == request.auth.uid;
    }

    function cityIdentityOnlyUpdate() {
      return ownsCityOwnerIdentity()
        && profileFieldUnchanged('clanReinforcementSlotCount')
        && (profileFieldUnchanged('ownerName') || validPlayerNameValue(request.resource.data.ownerName))
        && (profileFieldUnchanged('ownerFlag') || validPlayerFlagValue(request.resource.data.ownerFlag))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName',
          'ownerFlag',
          'updatedAt',
          'updatedBy'
        ]);
    }

    match /realmConfig/{configId} {
      allow read: if signedIn() && configId == 'current';
      allow create, update, delete: if false;
    }

    match /realmGenerations/{resetGeneration} {
      allow read, write: if false;

      match /assignments/{uid} {
        allow read: if ownsPlayerDoc(uid) && resetGeneration == currentResetGeneration();
        allow create, update, delete: if false;
      }

      match /shards/{shardId} {
        allow read, write: if false;
      }
    }

    match /players/{uid} {
      allow read: if ownsPlayerDoc(uid);
      allow create: if ownsPlayerDoc(uid) && validPlayerProfileCreate();
      allow update: if ownsPlayerDoc(uid) && validPlayerProfileUpdate();
      allow delete: if false;

      match /saves/{saveId} {
        allow read: if ownsPlayerDoc(uid)
          && saveId == 'default-' + currentResetGeneration();
        allow create, update: if ownsPlayerDoc(uid)
          && saveId == 'default-' + currentResetGeneration()
          && validPlayerSaveFlag();
        allow delete: if false;
      }

      match /incomingArmies/{armyId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /serverReports/{reportId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /stats/{statsId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /objectiveStats/{objectiveId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /dailyMissions/{cycleKey} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /seasonalAchievements/{seasonId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /serverMembership/{membershipId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /rewardedAds/{document=**} {
        allow read, create, update, delete: if false;
      }

      match /rewardedAdIntents/{intentId} {
        allow read, create, update, delete: if false;
      }

      match /protectedDefenseXpClaims/{attackerUid} {
        allow read, create, update, delete: if false;
      }

      match /cityUpgradeXp/{document=**} {
        allow read, create, update, delete: if false;
      }

      match /cityUpgradeRequests/{document=**} {
        allow read, create, update, delete: if false;
      }

      match /skillLevelAdjustmentRequests/{document=**} {
        allow read, create, update, delete: if false;
      }

      match /chatSendRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /notificationTokens/{tokenId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update: if ownsPlayerDoc(uid)
          && request.resource.data.uid == uid
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 2048
          && (!('installationId' in request.resource.data)
            || (request.resource.data.installationId is string
              && request.resource.data.installationId.size() >= 20
              && request.resource.data.installationId.size() <= 160))
          && request.resource.data.enabled is bool;
        allow delete: if ownsPlayerDoc(uid);
      }
    }

    match /realmEvents/{realmStorageId}/activity/{eventId} {
      allow read: if signedIn()
        && realmStorageId == currentRealmStorageId()
        && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    match /dailyMissionEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if signedIn() && boardId == currentRealmStorageId() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    function currentPlayerAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && isCurrentGeneration(get(/databases/$(database)/documents/players/$(request.auth.uid)).data);
    }

    function clanMember(clanId) {
      return currentPlayerAccount()
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.clanId == clanId
        && exists(/databases/$(database)/documents/clans/$(clanId))
        && get(/databases/$(database)/documents/clans/$(clanId)).data.resetGeneration == currentResetGeneration()
        && get(/databases/$(database)/documents/clans/$(clanId)).data.worldId == currentWorldId()
        && get(/databases/$(database)/documents/clans/$(clanId)).data.status == 'active'
        && exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.status == 'active'
        && isCurrentGeneration(get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data);
    }

    function clanManager(clanId) {
      return clanMember(clanId)
        && get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role in ['leader', 'officer'];
    }

    match /clans/{clanId} {
      allow read: if signedIn() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /applications/{uid} {
        allow read: if signedIn()
          && isCurrentGeneration(resource.data)
          && (request.auth.uid == uid || clanManager(clanId));
        allow create, update, delete: if false;
      }

      match /questProgress/{periodId} {
        allow get: if clanMember(clanId)
          && (
            !exists(/databases/$(database)/documents/clans/$(clanId)/questProgress/$(periodId))
            || (
              resource.data.questPeriodId == periodId
              && isCurrentGeneration(resource.data)
              && request.time >= resource.data.weekStartAt
              && request.time < resource.data.weekEndAt
            )
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /worldBenefits/{resetId} {
        allow read: if clanMember(clanId)
          && resetId == currentRealmStorageId()
          && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /memberRewards/{uid} {
        allow read: if clanMember(clanId)
          && request.auth.uid == uid
          && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /giftActivity/{resetId} {
        allow get: if clanMember(clanId)
          && resetId == currentRealmStorageId()
          && (
            !exists(/databases/$(database)/documents/clans/$(clanId)/giftActivity/$(resetId))
            || isCurrentGeneration(resource.data)
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /memberRewardHistory/{historyId} {
        allow read, create, update, delete: if false;
      }

      match /questCaptureReceipts/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /rallies/{rallyId} {
        allow read: if clanMember(clanId) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /rallyState/{resetId} {
        allow read, create, update, delete: if false;
      }

      match /operations/{operationId} {
        allow read, create, update, delete: if false;

        match /{legacyDocument=**} {
          allow read, create, update, delete: if false;
        }
      }

      match /operationState/{resetId} {
        allow read, create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if clanMember(clanId)
          && isCurrentGeneration(resource.data)
          && resource.data.status == 'visible';
        allow create, update, delete: if false;
      }

      match /messageReports/{reportId} {
        allow read, create, update, delete: if false;
      }

      match /audit/{eventId} {
        allow read, create, update, delete: if false;
      }
    }

    match /clanLeaderboards/{resetId}/entries/{clanId} {
      allow read: if signedIn()
        && resetId == currentRealmStorageId()
        && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    match /globalChat/{resetId}/messages/{messageId} {
      allow read: if currentPlayerAccount()
        && resetId == currentRealmStorageId()
        && isCurrentGeneration(resource.data)
        && resource.data.status == 'visible';
      allow create, update, delete: if false;
    }

    match /clanNameReservations/{reservationId} {
      allow read, create, update, delete: if false;
    }

    match /clanTagReservations/{reservationId} {
      allow read, create, update, delete: if false;
    }

    match /clanOperationReminders/{reminderId} {
      allow read, create, update, delete: if false;
    }

    match /crownCitadelReigns/{realmStorageId}/entries/{uid} {
      allow read: if signedIn() && realmStorageId == currentRealmStorageId() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    match /strongholdLegacies/{realmStorageId}/entries/{entryId} {
      allow read: if signedIn() && realmStorageId == currentRealmStorageId() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    match /gameServers/{serverId} {
      allow read, create, update, delete: if false;

      match /members/{uid} {
        allow read, create, update, delete: if false;
      }

      match /coordination/{documentId} {
        allow read, create, update, delete: if false;
      }
    }

    match /realmMaintenance/{resetId}/inactivePlayers/{uid} {
      allow read, create, update, delete: if false;
    }

    match /realmSecurity/{resetId}/{document=**} {
      allow read, create, update, delete: if false;
    }

    match /serverConfig/{configId} {
      allow read, create, update, delete: if false;
    }

    match /serverRateLimits/{rateLimitId} {
      allow read, create, update, delete: if false;
    }

    match /armies/{armyId} {
      allow read: if signedIn()
        && isCurrentGeneration(resource.data)
        && (resource.data.ownerUid == request.auth.uid
          || (resource.data.rallyAttack == true
            && resource.data.targetOwnerUid == request.auth.uid)
          || (resource.data.participantUids is list
            && request.auth.uid in resource.data.participantUids));
      allow create, update, delete: if false;
    }

    match /reinforcements/{reinforcementId} {
      allow read: if signedIn()
        && isCurrentGeneration(resource.data)
        && resource.data.status == 'stationed'
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.targetOwnerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reinforcementCapacity/{resetId}/cities/{capacityId} {
      allow read, create, update, delete: if false;
    }

    match /reinforcementBattleReceipts/{resetId}/entries/{receiptId} {
      allow read, create, update, delete: if false;
    }

    match /rallyBattleReceipts/{resetId}/entries/{receiptId} {
      allow read, create, update, delete: if false;
    }

    match /rewardCampPayoutReceipts/{resetId}/entries/{receiptId} {
      allow read, create, update, delete: if false;
    }

    match /serverNotificationOutbox/{notificationId} {
      allow read, create, update, delete: if false;
    }

    match /battleSnapshots/{realmStorageId}/entries/{battleId} {
      allow read: if signedIn()
        && realmStorageId == currentRealmStorageId()
        && isCurrentGeneration(resource.data)
        && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

    // Collection-group queries cannot prove a parent island path. Require both
    // realm identifiers and ownership so archived generations never leak.
    match /{path=**}/cities/{cityId} {
      allow read: if signedIn()
        && isCurrentGeneration(resource.data)
        && resource.data.ownerUid == request.auth.uid;
    }

    match /{path=**}/camps/{campId} {
      allow read: if signedIn()
        && isCurrentGeneration(resource.data)
        && resource.data.holderUid == request.auth.uid;
    }

    // Multiplayer layout, economy, armies, combat, and reports are server-owned.
    match /islands/{islandId} {
      allow read: if signedIn()
        && isCurrentIslandId(islandId);
      allow create, update, delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create: if false;
        allow update: if signedIn() && isCurrentIslandId(islandId) && cityIdentityOnlyUpdate();
        allow delete: if false;

        match /protectedAssaultBreaches/{attackerUid} {
          allow read, create, update, delete: if false;
        }
      }

      match /camps/{campId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update, delete: if false;

        match /rewardHistory/{entryId} {
          allow read: if signedIn()
            && isCurrentIslandId(islandId)
            && resource.data.awardedToPlayerId == request.auth.uid;
          allow create, update, delete: if false;
        }
      }

      match /armies/{armyId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if signedIn()
          && isCurrentIslandId(islandId)
          && !reportId.matches('.*_hold_.*');
        allow create, update: if false;
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update: if ownsPlayerDoc(uid)
          && isCurrentIslandId(islandId)
          && validOptionalPlayerFlag(request.resource.data);
        allow delete: if ownsPlayerDoc(uid) && isCurrentIslandId(islandId);
      }
    }
  }
}
