rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shieldCount(data) {
      return data.get('shopItems', {}).get('shield_12h', 0);
    }

    function shieldStockNotIncreased() {
      return shieldCount(request.resource.data) <= shieldCount(resource.data);
    }

    function validShieldPurchase() {
      return shieldCount(request.resource.data) > shieldCount(resource.data)
        && request.resource.data.get('gold', 0) is number
        && request.resource.data.get('gold', 0) >= 0;
    }

    function validPlayerProfileCreate() {
      return shieldCount(request.resource.data) == 0;
    }

    function validPlayerProfileUpdate() {
      return shieldStockNotIncreased() || validShieldPurchase();
    }

    match /players/{uid} {
      allow read: if ownsPlayerDoc(uid);
      allow create: if ownsPlayerDoc(uid) && validPlayerProfileCreate();
      allow update: if ownsPlayerDoc(uid) && validPlayerProfileUpdate();
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update: if ownsPlayerDoc(uid);
        allow delete: if ownsPlayerDoc(uid);
      }

      match /serverReports/{reportId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update, delete: if false;
      }
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if ownsPlayerDoc(uid)
        && request.resource.data.uid == uid
        && request.resource.data.kingPower is number
        && request.resource.data.kingPower >= 0
        && request.resource.data.cityCount is number
        && request.resource.data.cityCount >= 0;
      allow delete: if ownsPlayerDoc(uid);
    }

    // Phase 2 multiplayer collections. City layout/profile writes are still
    // browser-managed for the current prototype, but army orders, arrivals,
    // combat results, defense reports, and scout reports are server-owned.
    match /islands/{islandId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if false;
      }

      match /armies/{armyId} {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if signedIn();
        allow create, update: if false;
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsPlayerDoc(uid);
      }
    }
  }
}
