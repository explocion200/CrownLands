rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentResetGeneration() {
      return 'fresh-2026-07-26-server-reset';
    }

    function currentWorldId() {
      return 'main-fresh-2026-07-26-server-reset';
    }

    function isCurrentGeneration(data) {
      return data.get('resetGeneration', '') == currentResetGeneration()
        && data.get('worldId', '') == currentWorldId();
    }

    function isCurrentIslandId(islandId) {
      return islandId.matches('^main-fresh-2026-07-26-server-reset-.*$');
    }

    function shieldCount(data) {
      return data.get('shopItems', {}).get('shield_12h', 0);
    }

    function validPlayerNameValue(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 18
        && value.matches('^[A-Za-z0-9 _.-]+$');
    }

    function validPlayerProfileNameCreate() {
      return !request.resource.data.keys().hasAny(['playerName'])
        || validPlayerNameValue(request.resource.data.playerName);
    }

    function validPlayerProfileCreate() {
      return shieldCount(request.resource.data) == 0
        && validPlayerProfileNameCreate()
        && !request.resource.data.keys().hasAny([
          'gold',
          'goldFloat',
          'shopItems',
          'itemEffects',
          'itemPurchaseCooldowns',
          'economyUpdatedAtMs',
          'offlineProductionCities',
          'kingPower',
          'kingPowerVersion',
          'kingPowerUpdatedAtMs',
          'cityCount',
          'globalStats',
          'character',
          'upgrades',
          'mainCityId',
           'mainIslandId',
           'mainRegionId',
           'mainCityChangedAtMs',
           'mainCityAssignmentVersion',
           'clanId',
           'clanName',
           'clanTag',
           'clanRole',
           'clanIdentityRevision',
           'clanIdentityRevisionVersion',
           'clanIdentityUpdatedAtMs',
           'clanJoinCooldownUntilMs',
           'pendingClanApplicationId',
           'resetGeneration',
           'worldId',
           'releaseId',
           'cloudSaveSlot'
        ]);
    }

    function profileFieldUnchanged(field) {
      return request.resource.data.get(field, resource.data.get(field, null)) == resource.data.get(field, null);
    }

    function playerEconomyUnchanged() {
      return profileFieldUnchanged('gold')
        && profileFieldUnchanged('goldFloat')
        && profileFieldUnchanged('shopItems')
        && profileFieldUnchanged('itemEffects')
        && profileFieldUnchanged('itemPurchaseCooldowns')
        && profileFieldUnchanged('economyUpdatedAtMs')
        && profileFieldUnchanged('offlineProductionCities')
        && profileFieldUnchanged('kingPower')
        && profileFieldUnchanged('kingPowerVersion')
        && profileFieldUnchanged('kingPowerUpdatedAtMs')
        && profileFieldUnchanged('cityCount')
        && profileFieldUnchanged('globalStats');
    }

    function validPlayerProfileUpdate() {
      return playerEconomyUnchanged()
        && (profileFieldUnchanged('playerName') || validPlayerNameValue(request.resource.data.playerName))
        && profileFieldUnchanged('character')
        && profileFieldUnchanged('upgrades')
        && profileFieldUnchanged('mainCityId')
        && profileFieldUnchanged('mainIslandId')
        && profileFieldUnchanged('mainRegionId')
        && profileFieldUnchanged('mainCityChangedAtMs')
        && profileFieldUnchanged('mainCityAssignmentVersion')
        && profileFieldUnchanged('clanId')
        && profileFieldUnchanged('clanName')
        && profileFieldUnchanged('clanTag')
        && profileFieldUnchanged('clanRole')
        && profileFieldUnchanged('clanIdentityRevision')
        && profileFieldUnchanged('clanIdentityRevisionVersion')
        && profileFieldUnchanged('clanIdentityUpdatedAtMs')
        && profileFieldUnchanged('clanJoinCooldownUntilMs')
        && profileFieldUnchanged('pendingClanApplicationId')
        && profileFieldUnchanged('resetGeneration')
        && profileFieldUnchanged('worldId')
        && profileFieldUnchanged('releaseId')
        && profileFieldUnchanged('cloudSaveSlot');
    }

    function ownsCityOwnerIdentity() {
      return resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.get('ownerUid', null) == request.auth.uid;
    }

    function cityIdentityOnlyUpdate() {
      return ownsCityOwnerIdentity()
        && (profileFieldUnchanged('ownerName') || validPlayerNameValue(request.resource.data.ownerName))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName',
          'ownerFlag',
          'updatedAt',
          'updatedBy'
        ]);
    }

    match /players/{uid} {
      allow read: if ownsPlayerDoc(uid);
      allow create: if ownsPlayerDoc(uid) && validPlayerProfileCreate();
      allow update: if ownsPlayerDoc(uid) && validPlayerProfileUpdate();
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update: if ownsPlayerDoc(uid)
          && saveId == 'default-fresh-2026-07-26-server-reset';
        allow delete: if false;
      }

      match /serverReports/{reportId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /stats/{statsId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /objectiveStats/{objectiveId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /serverMembership/{membershipId} {
        allow read: if ownsPlayerDoc(uid) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /notificationTokens/{tokenId} {
        allow read: if ownsPlayerDoc(uid);
        allow create, update: if ownsPlayerDoc(uid)
          && request.resource.data.uid == uid
          && request.resource.data.token is string
          && request.resource.data.enabled is bool;
        allow delete: if ownsPlayerDoc(uid);
      }
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if signedIn() && boardId == currentResetGeneration() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    function clanMember(clanId) {
      return signedIn()
        && get(/databases/$(database)/documents/clans/$(clanId)).data.resetGeneration == currentResetGeneration()
        && exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid));
    }

    function clanManager(clanId) {
      return clanMember(clanId)
        && get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role in ['leader', 'officer'];
    }

    match /clans/{clanId} {
      allow read: if signedIn() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /applications/{uid} {
        allow read: if signedIn()
          && isCurrentGeneration(resource.data)
          && (request.auth.uid == uid || clanManager(clanId));
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if clanMember(clanId) && isCurrentGeneration(resource.data);
        allow create, update, delete: if false;
      }

      match /messageReports/{reportId} {
        allow read, create, update, delete: if false;
      }

      match /audit/{eventId} {
        allow read, create, update, delete: if false;
      }
    }

    match /clanLeaderboards/{resetId}/entries/{clanId} {
      allow read: if signedIn() && resetId == currentResetGeneration();
      allow create, update, delete: if false;
    }

    match /clanNameReservations/{reservationId} {
      allow read, create, update, delete: if false;
    }

    match /clanTagReservations/{reservationId} {
      allow read, create, update, delete: if false;
    }

    match /crownCitadelReigns/{resetId}/entries/{uid} {
      allow read: if signedIn() && resetId == currentResetGeneration() && isCurrentGeneration(resource.data);
      allow create, update, delete: if false;
    }

    match /gameServers/{serverId} {
      allow read, create, update, delete: if false;
    }

    match /armies/{armyId} {
      allow read: if signedIn()
        && isCurrentGeneration(resource.data)
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.targetOwnerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Multiplayer layout, economy, armies, combat, and reports are server-owned.
    match /islands/{islandId} {
      allow read: if signedIn()
        && isCurrentIslandId(islandId);
      allow create, update, delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create: if false;
        allow update: if signedIn() && isCurrentIslandId(islandId) && cityIdentityOnlyUpdate();
        allow delete: if false;
      }

      match /camps/{campId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update, delete: if false;

        match /rewardHistory/{entryId} {
          allow read: if signedIn() && isCurrentIslandId(islandId);
          allow create, update, delete: if false;
        }
      }

      match /armies/{armyId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update: if false;
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn() && isCurrentIslandId(islandId);
        allow create, update, delete: if ownsPlayerDoc(uid) && isCurrentIslandId(islandId);
      }
    }
  }
}
