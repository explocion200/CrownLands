rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /players/{uid} {
      allow read, create, update: if ownsPlayerDoc(uid);
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update: if ownsPlayerDoc(uid);
        allow delete: if ownsPlayerDoc(uid);
      }
    }

    // Phase 2 multiplayer collections. Keep writes locked until city/army
    // transactions are implemented and tested against real Firebase rules.
    match /islands/{islandId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /armies/{armyId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /reports/{reportId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsPlayerDoc(uid);
      }
    }
  }
}
