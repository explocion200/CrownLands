rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayerDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shieldCount(data) {
      return data.get('shopItems', {}).get('shield_12h', 0);
    }

    function shieldPurchaseAt(data) {
      return data.get('itemPurchaseCooldowns', {}).get('shield_12h', {}).get('lastPurchasedAt', null);
    }

    function shieldCooldownUnchanged() {
      return shieldPurchaseAt(request.resource.data) == shieldPurchaseAt(resource.data);
    }

    function shieldStockNotIncreased() {
      return shieldCount(request.resource.data) <= shieldCount(resource.data);
    }

    function validShieldPurchase() {
      return shieldCount(request.resource.data) == shieldCount(resource.data) + 1
        && request.resource.data.get('gold', 0) == resource.data.get('gold', 0) - 175000
        && shieldPurchaseAt(request.resource.data) == request.time
        && (
          !(shieldPurchaseAt(resource.data) is timestamp)
          || shieldPurchaseAt(resource.data) <= request.time - duration.value(24, 'h')
        );
    }

    function validPlayerProfileCreate() {
      return shieldCount(request.resource.data) == 0
        && shieldPurchaseAt(request.resource.data) == null;
    }

    function validPlayerProfileUpdate() {
      return (shieldStockNotIncreased() && shieldCooldownUnchanged())
        || validShieldPurchase();
    }

    match /players/{uid} {
      allow read: if ownsPlayerDoc(uid);
      allow create: if ownsPlayerDoc(uid) && validPlayerProfileCreate();
      allow update: if ownsPlayerDoc(uid) && validPlayerProfileUpdate();
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update: if ownsPlayerDoc(uid);
        allow delete: if ownsPlayerDoc(uid);
      }
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if ownsPlayerDoc(uid)
        && request.resource.data.uid == uid
        && request.resource.data.kingPower is number
        && request.resource.data.kingPower >= 0
        && request.resource.data.cityCount is number
        && request.resource.data.cityCount >= 0;
      allow delete: if ownsPlayerDoc(uid);
    }

    // Phase 2 multiplayer collections. Signed-in users can create the shared
    // island and update city docs for the browser prototype. Tighten these
    // rules when combat moves into server-verified transactions.
    match /islands/{islandId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;

      match /cities/{cityId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if false;
      }

      match /armies/{armyId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if signedIn();
      }

      match /reports/{reportId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsPlayerDoc(uid);
      }
    }
  }
}
